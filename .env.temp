
# 英伟达AI
NVIDIA_API_KEY=

## HF
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

## TENCENT
TENCENT_API_KEY=
TENCENT_BASE_URL=https://tokenhub.tencentmaas.com/v1
TENCENT_MODEL=qwen3.5-flash

## OPENROUTER
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# gemeni
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

## 监控视频刷新频率
VIDEO_CHECK_MINUTES=5

# 直播 ASR：stream（Gemini Live）或 segment（SenseVoice）
ASR_MODE=segment

# 视频 ASR：不填就跟随 ASR_MODE
# 想要视频用 Gemini Live 就配 stream 或 segment（SenseVoice）
VIDEO_ASR_MODE=segment

## 切片时长
SEGMENT_MINUTES=4

## ASR 设置
WHISPER_MODEL=~/whisper.cpp/models/ggml-small-q5_1.bin

## SENSEVOICE 路径
SENSEVOICE_DIR=~/sensevoice
SENSEVOICE_BIN=~/sensevoice/llama-funasr-sensevoice
SENSEVOICE_MODEL=~/sensevoice/gguf/sensevoice-small-q8.gguf
SENSEVOICE_VAD=~/sensevoice/gguf/fsmn-vad.gguf

# Termux 用 grun，其他系统改成 false
USE_GRUN=false
GRUN_BIN=grun
FFMPEG_BIN=ffmpeg

# 服务器
#ASR_SERVER_URL=http://192.168.0.105:3000
#ASR_SERVER_TIMEOUT=120

#抖音
DOUYIN_COOKIE=sessionid=xxxxx复制的抖音cookiexxxxx; ttwid=你的ttwid

